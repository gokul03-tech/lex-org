# =============================================================================
# LexOrch-KG: Trust-Aware Multi-Agent Legal Advisory Framework
# Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values:
#   cp configs/.env.example .env

# ── Application ─────────────────────────────────────────────────────────────
APP_NAME=LexOrch-KG
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production-use-a-secure-random-key
API_PREFIX=/api/v1

# ── Server ──────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
WORKERS=1

# ── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── Database (SQLite) ───────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./data/lexorch.db
DB_ECHO=false

# ── FalkorDB Knowledge Graph ────────────────────────────────────────────────
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_PASSWORD=
FALKORDB_GRAPH_NAME=lexorch

# ── Qdrant Vector Database ──────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_DOCS=legal_documents
QDRANT_COLLECTION_SECTIONS=legal_sections
QDRANT_VECTOR_SIZE=1024

# ── Redis / Celery ──────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── LLM Configuration ───────────────────────────────────────
# Options: llama_cpp | mock | openai_compatible | transformers
LLM_BACKEND=openai_compatible
QWEN_MODEL_PATH=
DEEPSEEK_MODEL_PATH=
LLM_N_CTX=17000
LLM_N_THREADS=8
LLM_N_GPU_LAYERS=0
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1500

# OpenAI-compatible API backend (vLLM / Ollama / OpenRouter)
LLM_API_BASE=https://openrouter.ai/api/v1
LLM_API_KEY=
QWEN_MODEL_NAME=meta-llama/llama-3.3-70b-instruct
DEEPSEEK_MODEL_NAME=meta-llama/llama-3.3-70b-instruct
# Single model for every step: Llama 3.3 70B (fast + strong both point here)
# GROQ_MODEL_* are aliases of FAST/STRONG (GROQ_* wins when both are set)
GROQ_MODEL_FAST=meta-llama/llama-3.3-70b-instruct
GROQ_MODEL_REASONING=meta-llama/llama-3.3-70b-instruct
# Retry/backoff for transient provider errors (HTTP 429 / 5xx)
LLM_MAX_RETRIES=5
LLM_RETRY_BASE_DELAY=5.0
LLM_RETRY_MAX_DELAY=60.0

# Transformers local backend
QWEN_HF_MODEL_ID=Qwen/Qwen3-8B-AWQ
DEEPSEEK_HF_MODEL_ID=casperhansen/deepseek-r1-distill-qwen-7b-awq

# Indian Kanoon API configuration
INDIANKANOON_API_KEY=
INDIANKANOON_API_BASE=https://api.indiankanoon.org

# ── Embedding Model ─────────────────────────────────────────────────────────
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32

# ── Cloud Embedding Backend ─────────────────────────────────────────────────
# local = sentence-transformers BGE-M3 | cloud = OpenAI-compatible API | auto = cloud when key set
EMBEDDING_BACKEND=auto
EMBEDDING_API_BASE=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
EMBEDDING_CLOUD_MODEL=BAAI/bge-m3
EMBEDDING_ALLOW_LOCAL_FALLBACK=true

# ── Document Processing ─────────────────────────────────────────────────────
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
OCR_LANG=en
OCR_USE_GPU=false
OCR_CLEAN_MAX_CHARS=3000
# Vision-LLM OCR fallback (multimodal model) for badly scanned PDFs.
VLM_OCR_ENABLED=true
VLM_OCR_MODEL=google/gemini-2.5-flash
VLM_OCR_MAX_PAGES=5
# Google AI Studio (Gemini) — primary LLM endpoint (free tier); the endpoint
# above (OpenRouter) is used as automatic fallback. Leave key empty to disable.
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
MAX_UPLOAD_SIZE_MB=50

# ── Sandbox ─────────────────────────────────────────────────────────────────
# Options: docker | process | none
SANDBOX_BACKEND=process
SANDBOX_TIMEOUT=120
SANDBOX_MAX_MEMORY_MB=4096
SANDBOX_MAX_CPU_CORES=2

# ── Dataset Paths ───────────────────────────────────────────────────────────
DATASETS_DIR=datasets
ACTS_DIR=datasets/acts
CONSTITUTION_DIR=datasets/constitution
LEGAL_CORPUS_DIR=datasets/datasets/legal_corpus

# ── Security ────────────────────────────────────────────────────────────────
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_BCRYPT_ROUNDS=12

# ── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=console
LOG_FILE=logs/app.log

# ── Evaluation ──────────────────────────────────────────────────────────────
EVAL_OUTPUT_DIR=outputs/evaluation
EVAL_RUN_ON_STARTUP=false
